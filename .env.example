# FIREBASE CONFIG (get from Firebase Console > Project Settings > General > Web App)
VITE_FIREBASE_API_KEY="MY_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"

# Comma-separated Firebase Auth UIDs allowed to access admin panel
# Get UIDs from Firebase Console > Authentication > Users
VITE_ADMIN_UIDS="uid1,uid2"
